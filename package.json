{
  "name": "controle-gastos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa:layout": "node scripts/qa-layout-audit.mjs",
    "qa:scorecard": "node scripts/qa-guardian-scorecard.mjs",
    "qa:check": "node scripts/qa-guardian-scorecard.mjs",
    "qa:cleanup": "node scripts/cleanup-test-users.mjs",
    "build": "tsc -b && vite build",
    "deploy": "npm run qa:check && npx --yes gh-pages -d dist",
    "lint": "oxlint",
    "preview": "vite preview",
    "audit:security": "node scripts/verify-security.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.58.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
